# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Sandbox for the willbrid.k8s Ansible role.
#
#   BOX_DISTRO / BOX_DISTRO_VERSION select the distribution, see README.md.
#   CP_MEM / CP_CPU / WORKER_MEM / WORKER_CPU resize the nodes.
#
# The role preflight requires at least 2 vCPU, 1700 MB of RAM and 10 GB free
# under /var on every node, so do not shrink the defaults below.

VAGRANTFILE_API_VERSION = "2"

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  guest_additions_iso = "./VBoxGuestAdditions_7.2.14.iso"

  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = false
    config.vbguest.no_remote = true
    config.vbguest.iso_path = guest_additions_iso if File.exist?(guest_additions_iso)
  end

  # bento/rockylinux-9 rather than the official rockylinux/9 box: the latter
  # ships a 10 GB disk, which leaves ~4.4 GB free and is rejected by the role
  # preflight (10 GB required under /var for the images and the etcd data).
  box_distro = ENV['BOX_DISTRO'] || "bento/rockylinux-9"
  box_version = ENV['BOX_DISTRO_VERSION'] || "202510.26.0"

  # 2560 rather than 2048 because of Rocky Linux 10: its kernel reserves enough
  # memory that a 2048 MB machine reports 1686 MB usable, just under the 1700 MB
  # the role preflight asks for. Rocky Linux 9, Debian and Ubuntu fit in 2048.
  cp_mem = (ENV['CP_MEM'] || "2560").to_i
  cp_cpu = (ENV['CP_CPU'] || "2").to_i
  worker_mem = (ENV['WORKER_MEM'] || "4096").to_i
  worker_cpu = (ENV['WORKER_CPU'] || "4").to_i

  # General Vagrant VM configuration
  config.ssh.insert_key = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.box = box_distro
  config.vm.box_version = box_version

  SERVERS = [
    { hostname: "control-server1", ip: "192.168.56.6", vcpu: cp_cpu, mem: cp_mem },
    { hostname: "control-server2", ip: "192.168.56.7", vcpu: cp_cpu, mem: cp_mem },
    { hostname: "worker-server",   ip: "192.168.56.8", vcpu: worker_cpu, mem: worker_mem }
  ]

  SERVERS.each do |server|
    config.vm.define server[:hostname] do |srv|
      srv.vm.hostname = server[:hostname]
      srv.vm.network :private_network, ip: server[:ip]
      srv.vm.provider :virtualbox do |v|
        v.name = "homelab-k8s-#{server[:hostname]}"
        v.cpus = server[:vcpu]
        v.memory = server[:mem]
      end
    end
  end
end
